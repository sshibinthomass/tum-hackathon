  <graph edgedefault="undirected">
    <node id="Transformer Model Architecture (discarded)">
      <data key="d0">Transformer Model Architecture (discarded)</data>
      <data key="d1">discarded</data>
      <data key="d2">This section discusses the limitations of RNNs in sequence modeling and transduction tasks and introduces the Transformer model architecture, which relies entirely on attention mechanisms to draw global dependencies between input and output sequences. The Transformer allows for more parallelization and can reach a new state-of-the-art in translation quality after being trained for as little as twelve hours on eight P100 GPUs.</data>
      <data key="d3">chunk-6e047c846a8a0495870e5d807cea1d03</data>
      <data key="d4">attention.pdf</data>
      <data key="d5">1763816166</data>
    </node>
    <node id="Author List and Acknowledgments (discarded)">
      <data key="d0">Author List and Acknowledgments (discarded)</data>
      <data key="d1">discarded</data>
      <data key="d2">This section lists the authors involved in the development of the Transformer model, including their affiliations and contributions to the work. It provides context about the research team behind this innovation in natural language processing.</data>
      <data key="d3">chunk-09d8ebc9bdc26f56c343b5eb5dc7b43f</data>
      <data key="d4">attention.pdf</data>
      <data key="d5">1763816166</data>
    </node>
    <node id="NIPS 2017 Conference (conference)">
      <data key="d0">NIPS 2017 Conference (conference)</data>
      <data key="d1">conference</data>
      <data key="d2">The 31st Conference on Neural Information Processing Systems (NIPS 2017) was held in Long Beach, CA, USA. This conference is relevant to the paper's topic of neural networks and machine translation models.</data>
      <data key="d3">chunk-87d1eb5532f12b6f54e6655859d90abe</data>
      <data key="d4">attention.pdf</data>
      <data key="d5">1763816166</data>
    </node>
