      <data key="d5">1763896826</data>
      <data key="d6" />
    </node>
    <node id="Formats">
      <data key="d0">Formats</data>
      <data key="d1">concept</data>
      <data key="d2">Formats describe the arrangement and presentation of document elements in Allplan, including hatching and pattern settings.</data>
      <data key="d3">chunk-722696e14943f4546267ecafc68e9e2c</data>
      <data key="d4">Allplan_2020_Manual.pdf</data>
      <data key="d5">1763888400</data>
      <data key="d6" />
    </node>
    <node id="Layout Structure">
      <data key="d0">Layout Structure</data>
      <data key="d1">concept</data>
      <data key="d2">Layout structure is a method for selecting specific layouts intended for printing to file.</data>
      <data key="d3">chunk-451be9692297c28020f54c8273fd6dca</data>
