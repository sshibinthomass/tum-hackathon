    <node id="Selection Rectangles">
      <data key="d0">Selection Rectangles</data>
      <data key="d1">method</data>
      <data key="d2">Selection Rectangles are methods used to define areas for selection within a graphical environment.&lt;SEP&gt;Selection Rectangles are a specific technique used to define areas for selecting multiple elements within a user interface.</data>
      <data key="d3">chunk-b97614e25388842c30e39c49a1e82bc2&lt;SEP&gt;chunk-8bea4ecbf369f8e5a0a1e8e93a7608c9</data>
