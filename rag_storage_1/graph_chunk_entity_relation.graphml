    <node id="Colors of Handles">
      <data key="d0">Colors of Handles</data>
      <data key="d1">concept</data>
      <data key="d2">Colors of Handles vary based on the actions taken by the user, which help in distinguishing between editable states during modifications.</data>
      <data key="d3">chunk-82cbcdc0a3c08b89e366f56c7b12be7c</data>
