    </node>
    <node id="Glyph">
      <data key="d0">Glyph</data>
      <data key="d1">concept</data>
      <data key="d2">A glyph is a symbolic figure or character, which in this case refers to the character '凸' identified as non-informative.</data>
      <data key="d3">chunk-50e9df5a650fbc684ffb520e8dadb5ef</data>
