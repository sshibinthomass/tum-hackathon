      <data key="d0">Point Snap</data>
      <data key="d1">concept</data>
      <data key="d2">Point Snap is a method for aligning points accurately when creating or editing designs.</data>
      <data key="d3">chunk-a007e42b9b683c4bb5c145f80014d5b7</data>
