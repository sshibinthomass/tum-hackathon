    <node id="Mouse Wheel">
      <data key="d0">Mouse Wheel</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The Mouse Wheel is a device used for zooming in and out on design sections and scrolling through dialog boxes in Allplan.</data>
