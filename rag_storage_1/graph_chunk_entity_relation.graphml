    <node id="Layered Design System">
      <data key="d0">Layered Design System</data>
      <data key="d1">concept</data>
      <data key="d2">Layered Design System refers to a system that organizes elements in layers, emphasizing format properties and management.</data>
      <data key="d3">chunk-3312cf4fab55427b11a562c6e43da9c0</data>
      <data key="d4">Allplan_2020_Manual.pdf</data>
      <data key="d5">1763896624</data>
      <data key="d6" />
    </node>
    <node id="From Layer Format Property">
      <data key="d0">From Layer Format Property</data>
      <data key="d1">concept</data>
      <data key="d2">From Layer Format Property is a specific technical aspect discussed in relation to layer management and functionality within the layered design system.</data>
      <data key="d3">chunk-3312cf4fab55427b11a562c6e43da9c0</data>
