    <node id="Backup Copies">
      <data key="d0">Backup Copies</data>
      <data key="d1">data</data>
      <data key="d2">Backup copies, referred to as .bak files, are created by Allplan for drawing files or layouts to restore original data if needed.</data>
      <data key="d3">chunk-03a9230f90f86536e2d89709e70964c9</data>
