      <data key="d1">category</data>
      <data key="d2">Open in Edit Mode drawing files are visible and modifiable, allowing up to 128 files to be opened simultaneously.</data>
      <data key="d3">chunk-cdaeced48a09bf3e6cabc0558e70ecf6</data>
      <data key="d4">Allplan_2020_Manual.pdf</data>
      <data key="d5">1763896715</data>
