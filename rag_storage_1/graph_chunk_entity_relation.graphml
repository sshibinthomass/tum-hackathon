    <node id="Allplan Vector Driver HPCOL_DESIGNJET">
      <data key="d0">Allplan Vector Driver HPCOL_DESIGNJET</data>
      <data key="d1">method</data>
      <data key="d2">Allplan Vector Driver HPCOL_DESIGNJET is a specific driver mentioned for enabling color output capabilities in printing.</data>
      <data key="d3">chunk-0e1b20c02cb1df7f4a3acfb70d457cbf</data>
