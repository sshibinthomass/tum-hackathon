      <data key="d1">category</data>
      <data key="d2">Open in Reference Mode drawing files are visible but cannot be modified, often used to configure program settings.</data>
      <data key="d3">chunk-cdaeced48a09bf3e6cabc0558e70ecf6</data>
      <data key="d4">Allplan_2020_Manual.pdf</data>
      <data key="d5">1763896715</data>
