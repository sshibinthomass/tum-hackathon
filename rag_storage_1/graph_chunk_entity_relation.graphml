    <node id="Geometric Parameters">
      <data key="d0">Geometric Parameters</data>
      <data key="d1">concept</data>
      <data key="d2">Geometric Parameters refer to the specific attributes of design elements that can be modified in Allplan through direct object modification.</data>
      <data key="d3">chunk-82cbcdc0a3c08b89e366f56c7b12be7c</data>
      <data key="d4">Allplan_2020_Manual.pdf</data>
      <data key="d5">1763888392</data>
      <data key="d6" />
