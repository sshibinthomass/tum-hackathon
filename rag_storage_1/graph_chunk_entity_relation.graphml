      <data key="d0">Rectangular Shape</data>
      <data key="d1">visualelement</data>
      <data key="d2">The Rectangular Shape is a graphical representation outlined in red, utilized within the software to assist with geometric measurements.&lt;SEP&gt;The Rectangular Shape is depicted in the image, likely representing a wall in a design context.</data>
      <data key="d3">chunk-56e0d709a61c2954fff181af06317028&lt;SEP&gt;chunk-aeaa37c59f36c7368264d42473294600</data>
