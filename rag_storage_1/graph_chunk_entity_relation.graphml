    <node id="Thickness Dialog Box">
      <data key="d0">Thickness Dialog Box</data>
      <data key="d1">tool</data>
      <data key="d2">The Thickness Dialog Box is a setting interface in Allplan where users can define different wall thicknesses.</data>
      <data key="d3">chunk-9bf93c97b7398da09d1cabc644a3e194</data>
